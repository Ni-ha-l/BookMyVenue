PORT=3005
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/bookmyvenue_notifications

JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production

REDIS_URL=redis://localhost:6379

RABBITMQ_URL=amqp://guest:guest@localhost:5672

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=BookMyVenue <noreply@bookmyvenue.com>

FCM_PROJECT_ID=your_firebase_project_id
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

CLIENT_URL=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_RETRY_ATTEMPTS=3
